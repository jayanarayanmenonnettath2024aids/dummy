# iTANTRA Configuration Environment Variables (Optional)
# Defaults will be used if unset.

# Web Dashboard Port
ITANTRA_WEB_PORT=8000

# TCP Socket Listen Port for Speech Packets
ITANTRA_TCP_PORT=65432

# Node Identifier
ITANTRA_NODE_NAME=NODE-ALPHA

# Default Spoken Language (en, hi, te, ml, ta, kn, mr, bn, gu)
ITANTRA_DEFAULT_LANGUAGE=en

# Operating Mode (walkie_talkie / voice_mode)
ITANTRA_OPERATING_MODE=walkie_talkie

# Model Precision (fp32 / int8)
ITANTRA_PRECISION=int8

# Security Enforcement (true / false)
ITANTRA_ENFORCE_SECURITY=false

# Hugging Face Token (Optional, only needed if accessing gated private repos)
# HF_TOKEN=
